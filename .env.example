# ── Supabase ────────────────────────────────────────────────────────────────
# Скопируй этот файл в .env.local и подставь значения из дашборда Supabase.
# Дашборд: https://supabase.com/dashboard → выбери проект.

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API Keys → anon / public key.
# Публичный ключ, попадает в браузер. Доступ ограничивается RLS-политиками (Этап 3).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API Keys → service_role / secret key.
# СЕКРЕТНЫЙ ключ, обходит RLS. Только сервер (seed-скрипты, серверные операции).
# НИКОГДА не префиксуй его NEXT_PUBLIC_ и не коммить реальное значение.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram-уведомления о новых заявках ────────────────────────────────────
# Необязательно. Если оба поля пустые — уведомления просто не отправляются,
# заявки всё равно сохраняются в базу.
#
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather (напиши ему /newbot).
# TELEGRAM_CHAT_ID    — id чата, куда слать. Узнать: напиши своему боту любое
#   сообщение, затем открой в браузере
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьми значение chat.id.
# Оба — СЕКРЕТНЫЕ, без префикса NEXT_PUBLIC_. В проде задаются в env Vercel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TELEGRAM_INSTRUCTORS_CHAT_ID — id группы инструкторов: туда уходят алерты о
# новых заявках («Принять») и напоминалки открыть/закрыть смену. Без этой
# переменной инструкторы молча не получают ничего — заявки при этом сохраняются
# и в группу заявок (TELEGRAM_CHAT_ID) уходят как обычно.
TELEGRAM_INSTRUCTORS_CHAT_ID=

# ── Отчёты начальнику (scripts/report-to-telegram.mjs) ──────────────────────
# Необязательно. Нужны только для скрипта отчётов, сайт без них работает.
# Это ОТДЕЛЬНЫЙ бот от бота заявок выше: другая группа, другие читатели.
#
# TELEGRAM_REPORT_BOT_TOKEN — токен бота-отчётника от @BotFather.
# TELEGRAM_REPORT_CHAT_ID   — id группы с начальником (у групп он со знаком
#   минус, например -1001234567890). Узнать так же: написать в группу, затем
#   открыть https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять chat.id.
TELEGRAM_REPORT_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=

# ── Кабинет клиента в Telegram (мини-приложение /member) ────────────────────
# Необязательно. Без этих переменных кабинет просто не работает: бот не
# ответит на «Поделиться номером», сайт и заявки при этом живут как обычно.
# Это ТРЕТИЙ бот: заявки, отчёты и клиенты — три разных токена, не путать.
#
# TELEGRAM_CLIENT_BOT_TOKEN  — токен клиентского бота от @BotFather.
# TELEGRAM_CLIENT_BOT_SECRET — придуманная длинная строка. Telegram кладёт её
#   в заголовок каждого запроса к /api/tg, а мы сверяем. Без неё адрес открыт
#   всему интернету: кто угодно пришлёт поддельный «контакт» с чужим номером
#   и получит доступ к чужому кабинету. Задавать ОБЯЗАТЕЛЬНО.
#
# После заполнения (и после каждой смены адреса сайта) один раз выполнить:
#   node scripts/setup-client-bot.mjs
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_SECRET=

# ── Крон-задачи Vercel ──────────────────────────────────────────────────────
# CRON_SECRET — общий пароль между Vercel и нашими /api/cron/*: Vercel сам
# подставляет его в заголовок Authorization: Bearer <секрет> при вызове крона.
# ОБЯЗАТЕЛЕН в проде: без него роуты отвечают 401, и напоминалки о смене,
# автоархив заявок и чистка фото просто не выполняются. Задать в Vercel →
# Settings → Environment Variables (значение — любая длинная случайная строка,
# например `openssl rand -hex 32`).
CRON_SECRET=

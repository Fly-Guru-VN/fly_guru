{
  "name": "flyguru",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "systemd-run --user --scope -q -p MemoryMax=4G -p MemorySwapMax=1G -- npx next dev",
    "dev:raw": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.109.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.80",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "2.116.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "@babel/helper-compilation-targets": {
      "browserslist": "4.28.8"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
